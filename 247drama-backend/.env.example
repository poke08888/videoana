# =====================================================
# 247dramas Backend - Environment Variables Template
# =====================================================
# COPY FILE NÀY THÀNH .env VÀ ĐIỀN GIÁ TRỊ THỰC TẾ
# (Copy this file to .env and fill in your real values)
# =====================================================

# --- Server ---
PORT=3000

# --- MongoDB ---
MongoDb_Connection_String=mongodb://localhost:27017/247dramas

# --- JWT ---
# Dùng để ký và xác thực JWT token cho Admin
JWT_SECRET=your_very_long_and_random_jwt_secret_here

# --- App Access Control ---
# Secret key dùng trong checkAccess.js để xác thực requests từ mobile app
secretKey=your_mobile_app_secret_key_here
